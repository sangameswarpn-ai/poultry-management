datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  FARMER
  FIELD_WORKER
  VET_OFFICER
  DISTRICT_ADMIN
  STATE_ADMIN
  LAB_OFFICER
  OFFICER
  ADMIN
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AlertStatus {
  PENDING
  INVESTIGATED
  RESOLVED
}

enum InspectionStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum ReportStatus {
  SUBMITTED
  UNDER_REVIEW
  INVESTIGATION
  RESOLVED
}

enum Species {
  POULTRY
  CATTLE
  GOAT
  PIG
}

model User {
  id             String          @id @default(uuid())
  name           String
  email          String          @unique
  passwordHash   String
  role           Role
  phone          String
  district       String?
  state          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  farms          Farm[]
  inspections    Inspection[]    @relation("OfficerInspections")
  diseaseReports DiseaseReport[] @relation("ReportedBy")
  notifications  Notification[]
}

model Farm {
  id                String             @id @default(uuid())
  name              String
  farmerId          String
  farmer            User               @relation(fields: [farmerId], references: [id])
  lat               Float
  lng               Float
  address           String
  district          String
  state             String
  biosecurityScore  Float              @default(100.0)
  riskLevel         RiskLevel          @default(LOW)
  species           Species            @default(POULTRY)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  biosecurityLogs   BiosecurityRecord[]
  healthLogs        HealthRecord[]
  riskAssessments   RiskAssessment[]
  riskAlerts        RiskAlert[]
  visitors          Visitor[]
  diseaseReports    DiseaseReport[]
  inspections       Inspection[]
  vaccinations      VaccinationRecord[]
  treatments        TreatmentRecord[]
}

model BiosecurityRecord {
  id             String   @id @default(uuid())
  farmId         String
  farm           Farm     @relation(fields: [farmId], references: [id])
  date           DateTime @default(now())
  disinfection   Boolean  @default(false)
  footbath       Boolean  @default(false)
  quarantine     Boolean  @default(false)
  ppe            Boolean  @default(false)
  otherChecks    Boolean  @default(false)
  complianceRate Float
  photoProofUrl  String?
  createdAt      DateTime @default(now())
}

model HealthRecord {
  id             String             @id @default(uuid())
  farmId         String
  farm           Farm               @relation(fields: [farmId], references: [id])
  date           DateTime           @default(now())
  totalAnimals   Int
  healthyCount   Int
  sickCount      Int
  mortalityCount Int
  species        Species            @default(POULTRY)
  symptoms       SymptomInRecord[]
  notes          String?
  createdAt      DateTime           @default(now())
}

model Symptom {
  id           String             @id @default(uuid())
  name         String             @unique // e.g., "Cough", "Fever", "Sudden Death"
  records      SymptomInRecord[]
  reports      SymptomInReport[]
}

model SymptomInRecord {
  healthRecordId String
  healthRecord   HealthRecord @relation(fields: [healthRecordId], references: [id], onDelete: Cascade)
  symptomId      String
  symptom        Symptom      @relation(fields: [symptomId], references: [id], onDelete: Cascade)

  @@id([healthRecordId, symptomId])
}

model RiskAssessment {
  id        String      @id @default(uuid())
  farmId    String
  farm      Farm        @relation(fields: [farmId], references: [id])
  date      DateTime    @default(now())
  score     Int // Risk score: 0 - 100
  level     RiskLevel
  factors   String // JSON-serialized array of factors (e.g. ["Mortality Spike", "Low Biosecurity"])
  details   String
  createdAt DateTime    @default(now())
  alerts    RiskAlert[]
}

model RiskAlert {
  id           String          @id @default(uuid())
  farmId       String
  farm         Farm            @relation(fields: [farmId], references: [id])
  assessmentId String
  assessment   RiskAssessment  @relation(fields: [assessmentId], references: [id])
  level        RiskLevel
  status       AlertStatus     @default(PENDING)
  message      String
  createdAt    DateTime        @default(now())
  inspections  Inspection[]
}

model Visitor {
  id         String    @id @default(uuid())
  farmId     String
  farm       Farm      @relation(fields: [farmId], references: [id])
  name       String
  phone      String
  purpose    String
  entryTime  DateTime  @default(now())
  exitTime   DateTime?
  qrCode     String
  status     String    @default("ACTIVE") // "ACTIVE", "EXITED"
  createdAt  DateTime  @default(now())
  vehicles   Vehicle[]
}

model Vehicle {
  id                 String    @id @default(uuid())
  visitorId          String
  visitor            Visitor   @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  plateNumber        String
  type               String
  disinfectionStatus Boolean   @default(false)
  entryTime          DateTime  @default(now())
  exitTime           DateTime?
  createdAt          DateTime  @default(now())
}

model DiseaseReport {
  id            String            @id @default(uuid())
  farmId        String?
  farm          Farm?             @relation(fields: [farmId], references: [id])
  reportedById  String
  reporter      User              @relation("ReportedBy", fields: [reportedById], references: [id])
  reporterRole  Role              @default(FARMER)
  species       Species           @default(POULTRY)
  symptoms      SymptomInReport[]
  notes         String?
  photoUrl      String?
  voiceUrl      String?
  status        ReportStatus      @default(SUBMITTED)
  
  // Regional/Location details
  state         String            @default("Tamil Nadu")
  district      String            @default("Namakkal")
  block         String?
  village       String?
  latitude      Float?
  longitude     Float?
  
  // Link to Cluster if part of an outbreak
  clusterId     String?
  cluster       OutbreakCluster?  @relation(fields: [clusterId], references: [id])
  
  // Link to DiseaseCase
  caseId        String?
  case          DiseaseCase?      @relation(fields: [caseId], references: [id])
  
  createdAt     DateTime          @default(now())
}

model SymptomInReport {
  diseaseReportId String
  diseaseReport   DiseaseReport @relation(fields: [diseaseReportId], references: [id], onDelete: Cascade)
  symptomId       String
  symptom         Symptom       @relation(fields: [symptomId], references: [id], onDelete: Cascade)

  @@id([diseaseReportId, symptomId])
}

model Inspection {
  id           String           @id @default(uuid())
  farmId       String
  farm         Farm             @relation(fields: [farmId], references: [id])
  inspectorId  String
  inspector    User             @relation("OfficerInspections", fields: [inspectorId], references: [id])
  alertId      String?
  alert        RiskAlert?       @relation(fields: [alertId], references: [id])
  date         DateTime
  notes        String?
  status       InspectionStatus @default(SCHEDULED)
  actionsTaken String?
  createdAt    DateTime         @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  read      Boolean  @default(false)
  type      String // e.g. "RISK_ALERT", "COMPLIANCE_REMINDER", "GOVERNMENT_ADVISORY"
  createdAt DateTime @default(now())
}

model Village {
  id        String   @id @default(uuid())
  name      String
  block     String
  district  String
  state     String   @default("Tamil Nadu")
  lat       Float?
  lng       Float?
  createdAt DateTime @default(now())
}

model OutbreakCluster {
  id             String          @id @default(uuid())
  name           String          // e.g. "CL-004"
  status         String          // "SUSPECTED", "FIELD_INVESTIGATION", "CONTAINED", "RESOLVED"
  riskLevel      RiskLevel       @default(LOW)
  firstReportDate DateTime
  lastReportDate  DateTime
  reportsCount   Int             @default(0)
  sickCount      Int             @default(0)
  mortalityCount Int             @default(0)
  villages       String          // JSON-serialized string array of affected villages
  reports        DiseaseReport[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model DiseaseCase {
  id           String          @id @default(uuid())
  title        String
  status       String          // e.g. "REPORTED", "SUSPECTED", "FIELD_INVESTIGATION", "SAMPLE_COLLECTED", "LAB_REFERRED", "CONFIRMED", "RESOLVED"
  severity     RiskLevel       @default(LOW)
  species      Species         @default(POULTRY)
  reports      DiseaseReport[]
  samples      Sample[]
  advisories   Advisory[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

model Sample {
  id             String        @id @default(uuid())
  caseId         String?
  case           DiseaseCase?  @relation(fields: [caseId], references: [id])
  sampleType     String        // e.g. "Blood", "Swab", "Fecal"
  collectionDate DateTime      @default(now())
  collectedBy    String
  location       String
  notes          String?
  status         String        // "COLLECTED", "PACKED", "DISPATCHED", "RECEIVED_BY_LAB", "TESTING", "RESULT_AVAILABLE"
  referrals      LabReferral[]
  createdAt      DateTime      @default(now())
}

model Lab {
  id        String        @id @default(uuid())
  name      String
  location  String
  district  String
  state     String        @default("Tamil Nadu")
  referrals LabReferral[]
  createdAt DateTime      @default(now())
}

model LabReferral {
  id               String    @id @default(uuid())
  sampleId         String
  sample           Sample    @relation(fields: [sampleId], references: [id])
  labId            String
  lab              Lab       @relation(fields: [labId], references: [id])
  status           String    // "SENT", "RECEIVED", "TESTING", "COMPLETED"
  result           String?   // Test results details
  confirmedDisease String?   // e.g. "Bird Flu", "FMD", "None"
  referredById     String
  referredAt       DateTime  @default(now())
  completedAt      DateTime?
}

model VaccinationRecord {
  id             String   @id @default(uuid())
  farmId         String?
  farm           Farm?    @relation(fields: [farmId], references: [id])
  species        Species  @default(POULTRY)
  vaccineName    String
  dose           String
  date           DateTime
  nextDueDate    DateTime?
  administeredBy String
  batchNumber    String
  status         String   // "COMPLETED", "OVERDUE", "SCHEDULED"
  createdAt      DateTime @default(now())
}

model TreatmentRecord {
  id           String   @id @default(uuid())
  farmId       String?
  farm           Farm?    @relation(fields: [farmId], references: [id])
  species      Species  @default(POULTRY)
  diagnosis    String
  treatment    String
  medicine     String
  date         DateTime
  veterinarian String
  outcome      String   // "RECOVERED", "DECEASED", "UNDER_TREATMENT"
  followUpDate DateTime?
  createdAt    DateTime @default(now())
}

model Advisory {
  id          String       @id @default(uuid())
  caseId      String?
  case        DiseaseCase? @relation(fields: [caseId], references: [id])
  title       String
  message     String
  severity    String       // "LOW", "MEDIUM", "HIGH", "CRITICAL"
  language    String       // "en", "ta", "hi"
  publishedAt DateTime     @default(now())
}

model WeatherObservation {
  id        String   @id @default(uuid())
  location  String
  temp      Float
  humidity  Float
  rainfall  Float
  date      DateTime @default(now())
}

model SyncQueue {
  id        String   @id @default(uuid())
  payload   String   // JSON string
  type      String   // "DISEASE_REPORT", "HEALTH_LOG", etc.
  status    String   // "PENDING", "SYNCED", "FAILED"
  error     String?
  createdAt DateTime @default(now())
}

