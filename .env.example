# Database Connection (Prisma)
# Replace with your PostgreSQL connection string for local development
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/poultry_management?schema=public"

# Next Auth (Future security integration)
NEXTAUTH_SECRET="your-nextauth-secret-here-at-least-32-characters"
NEXTAUTH_URL="http://localhost:3000"

# Future AWS Configuration (AWS Aurora, DynamoDB, SNS)
AWS_ACCESS_KEY_ID="your-aws-access-key-id"
AWS_SECRET_ACCESS_KEY="your-aws-secret-access-key"
AWS_REGION="ap-south-1" # Mumbai region
AWS_AURORA_DB_CLUSTER_ARN="arn:aws:rds:ap-south-1:123456789012:cluster:poultry-aurora-cluster"
AWS_DYNAMODB_TABLE_NAME="PoultryContactTracing"

# Push Notifications, SMS, WhatsApp (Mocked during initial phase)
SMS_GATEWAY_API_KEY="your-sms-api-key"
WHATSAPP_BUSINESS_API_TOKEN="your-whatsapp-token"
WHATSAPP_PHONE_NUMBER_ID="your-phone-number-id"
ONESIGNAL_APP_ID="your-onesignal-app-id"
ONESIGNAL_REST_API_KEY="your-onesignal-rest-api-key"
